<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Карточка доступа — kmasnaveev</title>
<style>
  :root {
    --ink: #16161a;
    --paper: #ffffff;
    --desk: #d9d5cc;
    --rule: #b9b3a6;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    padding: 32px 16px 64px;
    background: var(--desk);
    color: var(--ink);
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  button {
    font: inherit;
    font-weight: 600;
    padding: 9px 18px;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: var(--ink);
    color: #fff;
    cursor: pointer;
  }

  button:hover { background: #000; }
  button:focus-visible { outline: 2px solid #2f6df6; outline-offset: 2px; }

  select {
    font: inherit;
    padding: 8px 10px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: #fff;
  }

  .hint {
    max-width: 46ch;
    text-align: center;
    font-size: 12.5px;
    line-height: 1.5;
    color: #4a4740;
  }

  .sheet {
    display: grid;
    grid-template-columns: repeat(2, 58mm);
    gap: 6mm;
    justify-content: center;
  }

  .card {
    width: 58mm;
    padding: 6mm 5mm 7mm;
    background: var(--paper);
    border: 1px dashed var(--rule);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4mm;
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .card svg {
    width: 44mm;
    height: 44mm;
    display: block;
    shape-rendering: crispEdges;
  }

  .login {
    font-family: "Roboto Condensed", "Arial Narrow", Arial, sans-serif;
    font-size: 4.6mm;
    letter-spacing: 0.01em;
    text-align: center;
    word-break: break-word;
  }

  @media print {
    @page { size: A4; margin: 12mm; }
    body { background: #fff; padding: 0; gap: 0; display: block; }
    .toolbar, .hint { display: none; }
    .sheet { gap: 5mm; }
    .card { border: 1px dashed #999; }
  }
</style>
</head>
